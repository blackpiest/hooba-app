DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_dev
REDIS_URL=redis://localhost:6379
PORT=3000
# Один origin или несколько через запятую (CORS). Для API на :3000 и Vite на :5173 с другого хоста в Origin
# обязательно перечислите URL страницы, например:
# FRONTEND_ORIGIN=http://localhost:5173,http://192.168.10.196:5173
#
# Альтернатива только для NODE_ENV=development: один hostname — разрешены все порты (5173, 4173, …)
# CORS_DEV_HOSTNAME=192.168.10.196
# Десктопный клиент (app://hooba) разрешён в коде сервера и сюда его писать не нужно.
FRONTEND_ORIGIN=http://localhost:5173

# JWT: минимум 32 символа (HS256 access)
JWT_SECRET=dev-only-change-me-min-32-characters!!
ACCESS_TOKEN_EXPIRES_SEC=900
REFRESH_TOKEN_DAYS=30
# 0 — не доверять X-Forwarded-For. За nginx в prod ставится 1.
TRUST_PROXY_HOPS=0
# Секрет POST /api/v1/setup/bootstrap (setup_token). Пусто — процесс печатает токен в лог при старте.
# SETUP_TOKEN=

# TURN: секрет coturn --static-auth-secret. Короткоживущие креды собирает backend.
# TURN_AUTH_SECRET=dev-turn-auth-secret

# mediasoup (голос): если worker не собран (часто Windows без postinstall), API всё равно поднимется — SFU будет отключён.
# В каталоге backend: pnpm approve-builds → pnpm install, либо dev на Linux/WSL.
# mediasoup (голос): порты UDP/TCP для ICE; на VPS/LAN задайте публичный IP
# MEDIASOUP_LISTEN_IP=0.0.0.0
# IP/hostname в ICE (LAN/VPS; с другого ПК обязательно; WSL — IP хоста Windows). Пример: 192.168.1.10 или VPS-публичный IP
# MEDIASOUP_ANNOUNCED_IP=192.168.10.223
# Windows: DTLS connected, но нет RTP — MEDIASOUP_BIND_TO_ANNOUNCED=1 (bind = тот же IPv4, что в ICE) или MEDIASOUP_BIND_IP=...
# UDP режется — MEDIASOUP_PREFER_UDP=false
# Только один ПК + localhost: MEDIASOUP_ANNOUNCE_LOCALHOST=1
# MEDIASOUP_RTC_MIN_PORT=40000
# MEDIASOUP_RTC_MAX_PORT=49999
# Один порт UDP+TCP на всех участников голоса (WebRtcServer). Пусто — по порту на транспорт из диапазона выше.
# Клиенты с этого же ПК (loopback) всегда берут порт из диапазона.
# MEDIASOUP_WEBRTC_PORT=40000
# JSON массив RTCIceServer[] для браузера. username и credential из этого JSON клиенту не отдаются.
# Для turn/turns backend подставляет короткоживущую пару, если задан TURN_AUTH_SECRET.
# Пример:
# RTC_ICE_SERVERS_JSON=[{"urls":["stun:YOUR_VPS_PUBLIC_IP_OR_DOMAIN:3478"]},{"urls":["turn:YOUR_VPS_PUBLIC_IP_OR_DOMAIN:3478?transport=udp"]}]
# Локальный dev (infra/docker/docker-compose.dev.yml, секрет dev-turn-auth-secret):
# TURN_AUTH_SECRET=dev-turn-auth-secret
# RTC_ICE_SERVERS_JSON=[{"urls":["stun:127.0.0.1:3478"]},{"urls":["turn:127.0.0.1:3478?transport=udp"]}]
# Если WebSocket к backend идёт с 127.0.0.1 (два окна на одном ПК), backend не отдаёт эти ICE серверы в mediasoup — иначе часто «нет звука». Для NAT-тестов с другого устройства открывайте фронт по LAN IP и тогда TURN/STUN из JSON применяются.

# Политика ICE в браузере для mediasoup (см. docs/VOICE_RELIABILITY_RUNBOOK_V1.md).
# relay — только TURN (проверка «голос идёт через relay»); по умолчанию all.
# RTC_ICE_TRANSPORT_POLICY=relay

# Картинки в чате: перекодируются в WebP, оригиналы не хранятся.
# UPLOADS_DIR=./data/uploads
# Квота (байты, по умолчанию 5 ГиБ): при 80% удаляются самые старые картинки до 70%.
# UPLOADS_MAX_BYTES=5368709120
# Меньше этого свободного места на диске — загрузки отклоняются (по умолчанию 1 ГиБ).
# UPLOADS_MIN_FREE_BYTES=1073741824
# stream — файлы отдаёт backend (dev); x-accel — nginx через X-Accel-Redirect (prod).
# UPLOADS_SERVE_MODE=stream
