POSTGRES_PASSWORD=замените-на-сложный-пароль
JWT_SECRET=замените-на-секрет-не-короче-32-символов
SETUP_TOKEN=замените-на-секрет-bootstrap-не-короче-16
TRUST_PROXY_HOPS=1
# Домен или публичный IPv4 (режим без домена: сертификат Let's Encrypt на IP, см. ./install.sh install).
PUBLIC_DOMAIN=voice.example.com
FRONTEND_ORIGIN=https://voice.example.com
HTTP_PORT=80
HTTPS_PORT=443
NGINX_TLS_CERT=/etc/letsencrypt/live/voice.example.com/fullchain.pem
NGINX_TLS_KEY=/etc/letsencrypt/live/voice.example.com/privkey.pem

# mediasoup (RTP/ICE)
# ВАЖНО: публичный IPv4 ЭТОГО ЖЕ VPS, не домен: Firefox не разбирает домен в ICE-кандидате.
MEDIASOUP_ANNOUNCED_IP=YOUR_VPS_PUBLIC_IP
# 0: в контейнере нет публичного IP, bind на него ломает голос (1 — только для запуска без Docker на Windows).
MEDIASOUP_BIND_TO_ANNOUNCED=0
MEDIASOUP_RTC_MIN_PORT=40000
MEDIASOUP_RTC_MAX_PORT=40100
# Один порт UDP+TCP на всех участников голоса (внутри диапазона выше). Пустое значение — по порту на транспорт:
# тогда в голосе помещается примерно (MAX - MIN) / 2 человек на весь сервер.
MEDIASOUP_WEBRTC_PORT=40000

# coturn (TURN/STUN)
# ВАЖНО: внешний IP ЭТОГО ЖЕ VPS (модель: 1 сервер = 1 VPS).
TURN_EXTERNAL_IP=YOUR_VPS_PUBLIC_IP
TURN_REALM=voice.example.com
TURN_AUTH_SECRET=замените-на-секрет-coturn-не-короче-16
TURN_PORT=3478
TURN_MIN_PORT=50000
TURN_MAX_PORT=50100
# TURN TLS использует тот же Let's Encrypt сертификат, что nginx. coturn (пользователь nobody) читает
# его копию из infra/docker/turn-tls/ — её кладёт `./install.sh cert-hooks` и хук продления certbot.
TURN_TLS_ENABLED=1
TURN_TLS_PORT=5349

# ICE servers для фронта (передаются backend в voice signaling).
# Используется собственный coturn на том же VPS, без обязательных third-party сервисов.
RTC_ICE_SERVERS_JSON=[{"urls":["stun:voice.example.com:3478"]},{"urls":["turn:voice.example.com:3478?transport=udp","turns:voice.example.com:5349?transport=tcp"]}]
# relay — проверка голоса только через TURN (диагностика); в обычной эксплуатации не задавать или all.
# RTC_ICE_TRANSPORT_POLICY=relay

# Картинки в чате (docker volume uploads_prod). Квота в байтах, по умолчанию 5 ГиБ (менять: ./install.sh uploads-quota):
# при 80% самые старые картинки удаляются до 70%. Загрузки отклоняются, если на диске свободно меньше UPLOADS_MIN_FREE_BYTES.
# UPLOADS_MAX_BYTES=5368709120
# UPLOADS_MIN_FREE_BYTES=1073741824
