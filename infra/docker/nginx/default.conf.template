limit_req_zone $binary_remote_addr zone=hooba_auth:1m rate=2r/s;
limit_conn_zone $binary_remote_addr zone=hooba_ws:1m;

server {
    listen 80;
    server_name ${NGINX_DOMAIN};

    location / {
        return 301 https://$server_name$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${NGINX_DOMAIN};
    root /usr/share/nginx/html;
    index index.html;

    ssl_certificate ${NGINX_TLS_CERT};
    ssl_certificate_key ${NGINX_TLS_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json;

    location /api/v1/auth/ {
        limit_req zone=hooba_auth burst=30 nodelay;
        proxy_pass http://backend:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /api/ {
        proxy_pass http://backend:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Загрузка картинки в чат: один файл до 10 МБ (+ запас на multipart).
    location ~ ^/api/v1/channels/[0-9]+/attachments$ {
        client_max_body_size 11m;
        proxy_request_buffering on;
        proxy_pass http://backend:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Аватар сервера (первичная настройка и админка): файл до 2 МБ (+ запас на multipart).
    location ~ ^/api/v1/(server-settings|setup)/icon$ {
        client_max_body_size 3m;
        proxy_request_buffering on;
        proxy_pass http://backend:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Файлы картинок: только после проверки подписи backend'ом (X-Accel-Redirect), напрямую недоступны.
    # Тип жёстко image/webp, никакого исполнения и sniffing.
    location /_uploads/ {
        internal;
        alias /data/uploads/;
        types { }
        default_type image/webp;
        autoindex off;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Content-Security-Policy "default-src 'none'; sandbox" always;
        add_header Cross-Origin-Resource-Policy "cross-origin" always;
        # «Копировать изображение» в десктопе (app://hooba) читает файл через fetch. Ссылка подписана, cookie нет —
        # * безопасен. Заголовки ответа backend при X-Accel-Redirect nginx не переносит, поэтому задаём здесь.
        add_header Access-Control-Allow-Origin "*" always;
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    }

    location /ws {
        limit_conn hooba_ws 40;
        proxy_pass http://backend:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # PWA: service worker и манифест всегда проверяются заново — иначе новая версия приходит с опозданием.
    location = /sw.js {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location = /manifest.webmanifest {
        types { }
        default_type application/manifest+json;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location / {
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self'; media-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
        add_header X-Frame-Options "DENY" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        # Статичные og-теги из index.html: картинке нужен абсолютный URL, домен подставляем на лету.
        sub_filter 'content="/og-cover.jpg"' 'content="https://$host/og-cover.jpg"';
        sub_filter_once off;
        try_files $uri $uri/ /index.html;
    }
}
