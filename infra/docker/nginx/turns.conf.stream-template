# TURN по TLS (turns:) для голоса. TLS снимает nginx, а не coturn: coturn нельзя ограничить
# TLS 1.2 (его --no-tlsv1* задают только минимум), а TLS 1.3 на части сетей обрывается (ТСПУ),
# как и у сайта. Дальше обычный TURN по TCP в coturn внутри docker-сети.
# Этот путь клиент выбирает сам, только если прямой голос не поднялся (см. voice-ice-route.ts).
server {
    listen 5349 ssl;

    ssl_certificate ${NGINX_TLS_CERT};
    ssl_certificate_key ${NGINX_TLS_KEY};
    ssl_protocols TLSv1.2;
    ssl_session_cache shared:TURNS:5m;
    ssl_handshake_timeout 10s;

    proxy_connect_timeout 5s;
    # Пока клиент в голосе, по соединению каждые несколько секунд идут STUN-проверки.
    proxy_timeout 5m;
    proxy_pass ${NGINX_TURN_UPSTREAM};
}
